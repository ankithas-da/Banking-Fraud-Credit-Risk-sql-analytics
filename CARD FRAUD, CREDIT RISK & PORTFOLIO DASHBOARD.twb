    <worksheet name='Overdue by DPD bucket and income'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='2' fontcolor='#ffffff' fontname='Arial Black' italic='true'>OVERDUE BY DPD BUCKET &amp; INCOME</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='accounts+' name='federated.0xaa71w0lrazeb1ed0en20p7h6tj' />
          </datasources>
          <datasource-dependencies datasource='federated.0xaa71w0lrazeb1ed0en20p7h6tj'>
            <column caption='Overdue Amount' datatype='real' default-format='c&quot;£&quot;#,##0;-&quot;£&quot;#,##0' name='[Calculation_1136126485139458]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [dpd_as_of] &gt; 0 THEN [outstanding_gbp] ELSE 0 END' />
            </column>
            <column-instance column='[Calculation_1136126485139458]' derivation='Sum' name='[diff:sum:Calculation_1136126485139458:qk]' pivot='key' type='quantitative'>
              <table-calc diff-options='Relative' ordering-type='Rows' type='Difference'>
                <address>
                  <value>-1</value>
                </address>
              </table-calc>
            </column-instance>
            <column caption='Dpd As Of' datatype='integer' name='[dpd_as_of]' role='measure' type='quantitative' />
            <column caption='Dpd Bucket As Of' datatype='string' name='[dpd_bucket_as_of]' role='dimension' type='nominal' />
            <column caption='Income Band' datatype='string' name='[income_band]' role='dimension' type='nominal' />
            <column-instance column='[dpd_bucket_as_of]' derivation='None' name='[none:dpd_bucket_as_of:nk]' pivot='key' type='nominal' />
            <column-instance column='[income_band]' derivation='None' name='[none:income_band:nk]' pivot='key' type='nominal' />
            <column caption='Outstanding Gbp' datatype='real' name='[outstanding_gbp]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1136126485139458]' derivation='Sum' name='[sum:Calculation_1136126485139458:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0xaa71w0lrazeb1ed0en20p7h6tj].[none:dpd_bucket_as_of:nk]'>
            <groupfilter function='except' user:ui-domain='relevant' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:dpd_bucket_as_of:nk]' />
              <groupfilter function='union'>
                <groupfilter function='member' level='[none:dpd_bucket_as_of:nk]' member='&quot;Current&quot;' />
                <groupfilter function='member' level='[none:dpd_bucket_as_of:nk]' member='&quot;Settled&quot;' />
              </groupfilter>
            </groupfilter>
          </filter>
          <manual-sort column='[federated.0xaa71w0lrazeb1ed0en20p7h6tj].[none:dpd_bucket_as_of:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Current&quot;</bucket>
              <bucket>&quot;1-29&quot;</bucket>
              <bucket>&quot;30-59&quot;</bucket>
