      <aliases enabled='yes' />
      <column caption='Score Board' datatype='string' name='[Calculation_1136126484824064]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [credit_score] &lt; 580 THEN &quot;Poor&quot;&#13;&#10;ELSEIF [credit_score] &lt; 670 THEN &quot;Fair&quot;&#13;&#10;ELSEIF [credit_score] &lt; 740 THEN &quot;Good&quot;&#13;&#10;ELSEIF [credit_score] &lt; 800 THEN &quot;Very Good&quot;&#13;&#10;ELSE &quot;Excellent&quot;&#13;&#10;END' />
      </column>
      <column caption='Income Order' datatype='integer' name='[Calculation_1136126484983809]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [income_band] = &quot;&lt;20k&quot; THEN 1&#13;&#10;ELSEIF [income_band] = &quot;20k-40k&quot; THEN 2&#13;&#10;ELSEIF [income_band] = &quot;40k-70k&quot; THEN 3&#13;&#10;ELSEIF [income_band] = &quot;70k-120k&quot; THEN 4&#13;&#10;ELSEIF [income_band] = &quot;120k+&quot; THEN 5&#13;&#10;ELSE 99&#13;&#10;END' />
      </column>
      <column caption='Overdue Amount' datatype='real' default-format='c&quot;£&quot;#,##0;-&quot;£&quot;#,##0' name='[Calculation_1136126485139458]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [dpd_as_of] &gt; 0 THEN [outstanding_gbp] ELSE 0 END' />
      </column>
      <column caption='30+ DPD Rate' datatype='real' default-format='p0.0%' name='[Calculation_1136126485569540]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1432169864577028]) / COUNT([payment_obligation_id])' />
      </column>
      <column caption='Bucket Order' datatype='integer' name='[Calculation_1136126486110214]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [dpd_bucket_as_of] = &quot;Current&quot; THEN 1&#13;&#10;ELSEIF [dpd_bucket_as_of] = &quot;1-29&quot; THEN 2&#13;&#10;ELSEIF [dpd_bucket_as_of] = &quot;30-59&quot; THEN 3&#13;&#10;ELSEIF [dpd_bucket_as_of] = &quot;60-89&quot; THEN 4&#13;&#10;ELSE 5&#13;&#10;END' />
      </column>
      <column caption='Transaction Month' datatype='datetime' name='[Calculation_1136126496083979]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [transaction_datetime])' />
      </column>
      <column caption='Weighted Utilisation' datatype='real' default-format='p0.0%' name='[Calculation_1136126496165900]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([current_balance_gbp]) / SUM([credit_limit_gbp])' />
      </column>
      <column caption='CNP Flagged' datatype='integer' name='[Calculation_1136126497193998]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [transaction_channel] IN (&quot;Online&quot;, &quot;Phone Order&quot;)&#13;&#10;   AND [amount_gbp] &gt;= [Parameters].[Parameter 1136126496342029]&#13;&#10;THEN 1 ELSE 0 END' />
      </column>
      <column caption='Fraud Captured' datatype='integer' name='[Calculation_1136126497271823]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1136126497193998] = 1 AND [is_fraud_label] = 1 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Genuine Flagged' datatype='integer' name='[Calculation_1136126497386512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1136126497193998] - [Calculation_1136126497271823]' />
      </column>
      <column caption='Precision' datatype='real' default-format='p0.0%' name='[Calculation_1136126497472529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1136126497271823]) / SUM([Calculation_1136126497193998])' />
      </column>
      <column caption='Recall' datatype='real' default-format='p0.0%' name='[Calculation_1136126497525778]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1136126497271823]) / SUM([is_fraud_label])' />
      </column>
      <column caption='Fraud Value Flagged' datatype='real' default-format='c&quot;£&quot;#,##0;-&quot;£&quot;#,##0' name='[Calculation_1136126497607699]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_fraud_label] = 1 THEN [amount_gbp] ELSE 0 END' />
      </column>
      <column aggregation='Sum' caption='Hour of Day' datatype='integer' name='[Calculation_1432169864085504]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&apos;hour&apos;, [transaction_datetime])' />
      </column>
      <column caption='Weekday' datatype='string' name='[Calculation_1432169864212481]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [transaction_datetime])' />
      </column>
      <column caption='Fraud Rate' datatype='real' default-format='p0.0%' name='[Calculation_1432169864388610]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_fraud_label]) / COUNT([transaction_id])' />
      </column>
      <column caption='Collection Rate' datatype='real' default-format='p0.0%' name='[Calculation_1432169864495107]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([amount_paid_gbp]) / SUM([amount_due_gbp])' />
      </column>
      <column caption='30+ DPD Flag' datatype='integer' name='[Calculation_1432169864577028]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [dpd_as_of] &gt;= 30 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Account Age (months)' datatype='integer' name='[Calculation_1432169864835077]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [account_open_date], [transaction_datetime])' />
      </column>
      <column caption='Weekday Number' datatype='integer' name='[Calculation_1432169865572358]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;weekday&apos;, [transaction_datetime])' />
      </column>
      <column caption='Fraud Value' datatype='real' name='[Calculation_1432169901568007]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_fraud_label] = 1 THEN [amount_gbp] ELSE 0 END' />
      </column>
      <column caption='Total Fraud Value' datatype='real' name='[Calculation_1432169908051981]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM([Calculation_1432169901568007]) }' />
      </column>
      <column caption='Cumulative Share' datatype='real' default-format='p0%' name='[Calculation_1432169908846606]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Calculation_1432169901568007])) / MAX([Calculation_1432169908051981])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Transaction Location' datatype='string' name='[Calculation_1432169912164368]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_international] = 1 THEN &quot;International&quot; ELSE &quot;Domestic&quot; END' />
