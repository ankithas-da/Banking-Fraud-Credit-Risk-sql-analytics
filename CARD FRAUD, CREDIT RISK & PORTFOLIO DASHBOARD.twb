    <worksheet name='Fraud rate by hour and weekday'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#4e79a7' fontname='Bookman Old Style' italic='true'>FRAUD RATE BY HOUR &amp; WEEKDAY</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='accounts+' name='federated.0xaa71w0lrazeb1ed0en20p7h6tj' />
          </datasources>
          <datasource-dependencies datasource='federated.0xaa71w0lrazeb1ed0en20p7h6tj'>
            <column aggregation='Sum' caption='Hour of Day' datatype='integer' name='[Calculation_1432169864085504]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&apos;hour&apos;, [transaction_datetime])' />
            </column>
            <column caption='Weekday' datatype='string' name='[Calculation_1432169864212481]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [transaction_datetime])' />
