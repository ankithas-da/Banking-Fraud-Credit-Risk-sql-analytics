    <worksheet name='International vs Domestic Fraud by channel'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#4e79a7' fontname='Bookman Old Style' italic='true'>INTERNATIONAL VS DOMESTIC FRAUD BY CHANNEL</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='accounts+' name='federated.0xaa71w0lrazeb1ed0en20p7h6tj' />
          </datasources>
          <datasource-dependencies datasource='federated.0xaa71w0lrazeb1ed0en20p7h6tj'>
            <column caption='Fraud Rate' datatype='real' default-format='p0.0%' name='[Calculation_1432169864388610]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([is_fraud_label]) / COUNT([transaction_id])' />
            </column>
            <column caption='Transaction Location' datatype='string' name='[Calculation_1432169912164368]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_international] = 1 THEN &quot;International&quot; ELSE &quot;Domestic&quot; END' />
            </column>
            <column-instance column='[__tableau_internal_object_id__].[transactions.csv_0A95C630249B4ECAAFE65798DBC0AA2C]' derivation='Count' name='[__tableau_internal_object_id__].[cnt:transactions.csv_0A95C630249B4ECAAFE65798DBC0AA2C:qk]' pivot='key' type='quantitative' />
